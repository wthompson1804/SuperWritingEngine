# Copy to /etc/margin.env (or pass as container environment). Only the first
# two are required for a public site; everything else has a safe default.

# The canonical https URL. Turns on production mode: Secure cookies, HSTS,
# no on-screen confirm links, no synthetic demo numbers. Fediverse ids,
# email links and scheduled posts all use it, so it must not change later.
MARGIN_PUBLIC_URL=https://margin.example

# Where to send mail from. Without MARGIN_SMTP_URL nothing is sent and
# confirmation/new-post mail just accumulates in the database.
MARGIN_SMTP_URL=smtp://username:password@smtp.example.com:587
MARGIN_MAIL_FROM=Margin <hello@margin.example>

# Set to 1 when a reverse proxy (nginx, Caddy, a load balancer) sits in
# front, so rate limits and note flags see the real client address from
# X-Forwarded-For instead of the proxy's.
MARGIN_TRUST_PROXY=1

# One JSON line per request on stdout (method, path, status, duration).
MARGIN_LOG=1

# Listen address and port.
PORT=3000
HOST=127.0.0.1

# Database file. Media and backups are stored next to it.
# MARGIN_DB=/srv/margin/data/margin.db

# Only for local development: allow http and private addresses in federation,
# show confirm links on screen, seed fake reading numbers.
# MARGIN_AP_INSECURE=1
# MARGIN_SHOW_MAIL=1
# MARGIN_DEMO_SIGNALS=1
