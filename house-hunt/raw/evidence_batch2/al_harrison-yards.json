_text": null, "neighborhood_id": 761533, "meta_neighborhood_id": null, "zip_code_id": 713870, "city_id": 708058, "county_id": 710096, "state_id": 257077, "metro_id": 762822, "updated_at": "2026-11-15T06:57:07.779Z", "availability_last_checked_at": "2026-11-15T06:53:30.627Z", "has_unit_level_availability": true, "active": true, "type": "Property", "price_type": null, "sponsored": false, "tourable": false, "advertisable": true, "online_bookable": false, "contract": "basic", "provider": {}, "provider_group": {}, "attribution": {}, "allow_call_transfer": false, "remote_listing_key": null, "slug": "/nj/harrison/harrison-yards", "total_units_count": 205, "contact_logic": "default", "contact_volume_threshold": 100, "contact_volume_multiplier": null, "year_built": 2021, "year_remodeled": null, "source_name": "real_page_mits4", "source_display_name": "ListHub", "source_listing_url": null, "copyright_disclaimer": null, "listing_agent_name": null, "brokerage_name": null, "upsells": ["lift"], "has_cross_sell": true, "covid_disclaimer": false, "ai_nurture_percent": null, "pmc_display_name": null, "listed_status": null, "mls_number": null, "occupancy_types": [], "display_occupancy_types": [], "long_highlight": "Harrison Yards stands out in a desirable and redeveloped factory town, bringing luxury living to Harrison with spacious apartments that bathe in natural light. Just a short walk to the PATH train station, commuting to New York City is both convenient and quick. The property's management receives high praise for their efficient and friendly service, underpinning a comfortable living experience. With well-kept amenities, such as a fully equipped fitness center and inviting outdoor spaces like a terrace and fire pit, residents find plenty of opportunities to unwind. Nestled in a popular neighborhood, the community also benefits from an impressive number of nearby schools, parks, and eateries. Both cats and dogs are welcome, making it a delightful home for pet owners.", "short_highlight": "Harrison Yards provides contemporary luxury living infused with historic charm in a vibrantly redeveloped neighborhood. The property's close proximity to the PATH train station ensures effortless commutes to New York City. Community amenities are well-maintained, offering inviting spaces for relaxation and socializing in a smoke-free environment.", "highlight_title": "Luxury living in a vibrant, historic community.", "highlight_tag": "Urban Convenience", "logo_public_id": null, "office_name": null, "office_phone": null, "agent_name": null, "broker_license_number": null, "deposit_fee_text": "", "application_fee_text": null, "additional_fees_text": null, "move_in_fees_text": null, "specials": [], "utilities_included_text": null, "show_price": true, "fees": {"show_plus_with_price": true, "fee_url": "https://www.canva.com/design/DAGNc2xiIqo/imRP04ShGN43CR_mnVJ2lA/view?embed"}, "cash_only": false, "pet_policies": {"allowed": true, "allowed_pets": ["cats", "dogs"], "details": "", "cats": {"deposit": "", "rent": "", "limit": "", "fee": "", "restrictions": ""}, "dogs": {"deposit": "", "rent": "", "limit": "", "fee": "", "restrictions": ""}, "general": {"deposit": "", "rent": "", "limit": "", "fee": "", "restrictions": ""}}, "credit_check_required_text": null, "criminal_check_required_text": null, "evictions_allowed": "case_by_case", "evictions_policy": null, "first_time_tenants_allowed_text": null, "income_requirement_text": "Must have 3x the rent in total household income (before taxes)", "income_multiplier_requirement": 3, "smoking_common_allowed_text": null, "smoking_in_unit_allowed_text": null, "prior_evictions_allowed_text": null, "qualification_detail_url": null, "additional_disclosures_url": null, "office_hours_this_week": {"sunday": ["2026-11-15T17:00:00.000Z", "2026-11-15T22:00:00.000Z"], "monday": ["2026-11-16T15:00:00.000Z", "2026-11-16T23:00:00.000Z"], "tuesday": ["2026-11-17T15:00:00.000Z", "2026-11-17T23:00:00.000Z"], "wednesday": ["2026-11-18T15