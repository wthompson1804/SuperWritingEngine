# Large raw captures that a script can re-download. Keep _index.jsonl and meta files.
*.pyc
__pycache__/
raw/**/*.parquet
raw/big/
# Raw HTML pages from third-party sites embed their own API tokens (GitHub push protection
# blocks them). Keep HTML captures on disk only; _index.jsonl and meta files are still committed.
raw/**/*.html
raw/**/*.htm
raw/fbi_cde/*.json
# third-party scripts and stylesheets cached by agents can embed the site's own tokens
raw/**/*.js
raw/**/*.css
